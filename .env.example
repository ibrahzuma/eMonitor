# eMonitor configuration — copy to /etc/emonitor/emonitor.env (mode 0640, owner root:emonitor).
# All values below are PLACEHOLDERS. Never commit real secrets.

EMONITOR_ENVIRONMENT=production
EMONITOR_PUBLIC_BASE_URL=https://monitor.example.com
EMONITOR_LOG_LEVEL=INFO
EMONITOR_LOG_JSON=true

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EMONITOR_SECRET_KEY=CHANGE_ME_random_64_chars
# Fernet key for encrypting stored credentials (SNMP communities, DB passwords, bot tokens).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored secrets unreadable — back it up separately from the database.
EMONITOR_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# PostgreSQL (application role with least privilege; migrations use the owner role, see docs/DEPLOYMENT.md)
EMONITOR_DATABASE_URL=postgresql+asyncpg://emonitor_app:CHANGE_ME@127.0.0.1:5432/emonitor
EMONITOR_DATABASE_POOL_SIZE=10
EMONITOR_DATABASE_MAX_OVERFLOW=20

# Redis (bind to localhost, requirepass set)
EMONITOR_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# ClickHouse (HTTP interface)
EMONITOR_CLICKHOUSE_HOST=127.0.0.1
EMONITOR_CLICKHOUSE_PORT=8123
EMONITOR_CLICKHOUSE_USER=emonitor
EMONITOR_CLICKHOUSE_PASSWORD=CHANGE_ME
EMONITOR_CLICKHOUSE_DATABASE=emonitor
EMONITOR_CLICKHOUSE_SECURE=false

# Web security
EMONITOR_COOKIE_SECURE=true
EMONITOR_CORS_ORIGINS=https://monitor.example.com
EMONITOR_TRUSTED_PROXIES=127.0.0.1,::1

# Rate limits (count/seconds)
EMONITOR_RATE_LIMIT_LOGIN=10/300
EMONITOR_RATE_LIMIT_API=600/60

# Outbound probe policy. Private targets additionally require the org's monitoring scope to list the CIDR.
EMONITOR_ALLOW_PRIVATE_TARGETS=true
# Networks probes may never reach (e.g. the platform's own database/management network):
EMONITOR_PROBE_BLOCKED_CIDRS=127.0.0.0/8

# Platform SMTP (password reset emails; default relay for email channels)
EMONITOR_SMTP_HOST=smtp.example.com
EMONITOR_SMTP_PORT=587
EMONITOR_SMTP_USERNAME=CHANGE_ME
EMONITOR_SMTP_PASSWORD=CHANGE_ME
EMONITOR_SMTP_STARTTLS=true
EMONITOR_SMTP_FROM="eMonitor <noreply@example.com>"

# Syslog collector
EMONITOR_SYSLOG_BIND=0.0.0.0
EMONITOR_SYSLOG_UDP_PORT=514
EMONITOR_SYSLOG_TCP_PORT=514
